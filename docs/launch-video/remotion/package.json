{
  "name": "buddy-launch-video",
  "private": true,
  "version": "1.0.0",
  "description": "Remotion launch films for buddy, the desktop sidekick.",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "remotion render src/index.tsx BuddyLaunch out/buddy-launch.mp4",
    "render:lessons": "remotion render src/index.tsx LaunchVideo out/launch-video.mp4",
    "render:still": "remotion still src/index.tsx BuddyLaunch out/buddy-launch-still.png --frame=2760",
    "sfx": "python3 scripts/make-chirps.py",
    "typecheck": "tsc --noEmit -p .",
    "verify": "node scripts/verify-launch-video.mjs && node scripts/verify-buddy-launch.mjs",
    "verify:render": "node scripts/verify-rendered-video.mjs out/buddy-launch.mp4 93"
  },
  "dependencies": {
    "@remotion/cli": "4.0.524",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.524"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
